# Backend test suite database — REQUIRED for `npm test` / `npm run test:backend`.
# The suite migrates and TRUNCATES every table, so this must point at a
# disposable local Postgres only. Selection fails closed: the URL must be a
# postgres:// URL on a loopback host (localhost/127.0.0.1/::1) whose database
# name contains "test". DATABASE_URL is never inherited by tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tomorrow_echo_test
