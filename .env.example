# PostgreSQL connection string. Neon uses the same node-postgres driver —
# keep the ?sslmode=require parameter on Neon URLs.
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Better Auth: random >=32-char secret (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Better Auth base URL of this app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000
